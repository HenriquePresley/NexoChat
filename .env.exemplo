# Modelo do .env. O NexoChat cria o ".env" sozinho a partir deste arquivo; preencha as suas chaves abaixo.
PORT=3000

# IA: Gemini (Google). Chave gratuita em https://aistudio.google.com/apikey
IA_PROVEDOR=gemini
GEMINI_API_KEY=
IA_MODELO=gemini-3-flash-preview
# Outros modelos para revezar quando um congestionar ou bater o limite (separe por espaço)
IA_MODELO_RESERVA=gemini-3.5-flash-lite gemini-3.6-flash gemini-3.8-flash gemini-3.1-flash-lite
# Plano B gratuito: com a chave do Groq preenchida, ele assume quando todo o Gemini falhar
GROQ_API_KEY=
# Quantas mensagens recentes a IA relê a cada resposta (menos = gasta menos cota)
IA_HISTORICO=16
# Segundos que a IA espera o cliente terminar de digitar antes de responder
IA_ESPERA_SEGUNDOS=4

# Para usar SÓ o Groq (https://console.groq.com/keys) no lugar do Gemini:
# IA_PROVEDOR=groq
# IA_MODELO=openai/gpt-oss-20b
# IA_MODELO_RESERVA=llama-3.1-8b-instant

# Para trocar para o ChatGPT depois: mude IA_PROVEDOR=openai, preencha a chave e o modelo
# OPENAI_API_KEY=
# IA_MODELO=gpt-5-mini
# IA_MODELO_RESERVA=

# Ou para o Claude:
# IA_PROVEDOR=anthropic
# ANTHROPIC_API_KEY=
# IA_MODELO=claude-haiku-4-5

# SGP (TSMX): Administração > Integrações > Tokens > Adicionar Token
# Libere o IP deste servidor no token.
SGP_URL=https://SEU-PROVEDOR.sgp.net.br
SGP_APP=chatbot
SGP_TOKEN=
# Se o SGP recusar JSON, troque para: form
SGP_FORMATO=json
# Id do tipo de ocorrência usado ao abrir chamado (veja no SGP; vazio usa o padrão)
SGP_TIPO_CHAMADO=

# Fuso usado em protocolos e relatórios
FUSO=America/Fortaleza
LIMITE_MB=64
